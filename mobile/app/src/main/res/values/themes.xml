<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.SolarMicrogrid" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_600</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_50</item>
        <item name="colorOnPrimaryContainer">@color/brand_800</item>

        <item name="colorSecondary">@color/solar_500</item>
        <item name="colorOnSecondary">@color/ink_900</item>
        <item name="colorSecondaryContainer">@color/solar_50</item>
        <item name="colorOnSecondaryContainer">@color/solar_600</item>

        <item name="colorError">@color/rose_600</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorErrorContainer">@color/rose_50</item>
        <item name="colorOnErrorContainer">@color/rose_700</item>

        <item name="android:colorBackground">@color/page_background</item>
        <item name="colorSurface">@color/white</item>
        <!-- Keeps elevated cards/bars truly white instead of picking up
             Material 3's green-tinted elevation overlay. -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorOnSurface">@color/slate_900</item>
        <item name="colorOnSurfaceVariant">@color/slate_500</item>
        <item name="colorOutline">@color/slate_300</item>
        <item name="colorOutlineVariant">@color/slate_200</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <item name="materialButtonStyle">@style/Widget.Solar.Button</item>
        <item name="textInputStyle">@style/Widget.Solar.TextInputLayout</item>
    </style>

    <!-- Screens that paint their own dark hero behind the status bar. -->
    <style name="Theme.SolarMicrogrid.Dark" parent="Theme.SolarMicrogrid">
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.SolarMicrogrid.NoActionBar" parent="Theme.SolarMicrogrid" />

    <!-- Buttons -->
    <style name="Widget.Solar.Button" parent="Widget.Material3.Button">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/brand_600</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Solar.Button.Danger" parent="Widget.Solar.Button">
        <item name="backgroundTint">@color/rose_600</item>
    </style>

    <style name="Widget.Solar.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/slate_300</item>
        <item name="android:textColor">@color/slate_700</item>
    </style>

    <style name="Widget.Solar.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/brand_700</item>
    </style>

    <!-- Text fields -->
    <style name="Widget.Solar.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/brand_600</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="hintTextColor">@color/brand_700</item>
        <item name="android:textColorHint">@color/slate_400</item>
    </style>

    <style name="Widget.Solar.TextInputLayout.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/brand_600</item>
        <item name="hintTextColor">@color/brand_700</item>
        <item name="android:textColorHint">@color/slate_400</item>
    </style>

    <style name="Widget.Solar.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/brand_100</item>
    </style>

    <!-- Surfaces -->
    <style name="Widget.Solar.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="strokeColor">@color/slate_200</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Typography -->
    <style name="Text.Solar.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/slate_900</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Solar.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/slate_900</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Solar.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/slate_600</item>
    </style>

    <style name="Text.Solar.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/slate_500</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
